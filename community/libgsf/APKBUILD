maintainer="team/gnome <achill@achill.org>"
pkgname=libgsf
pkgver=1.14.61
pkgrel=0
pkgdesc="Utility library for reading and writing structured file formats"
url="https://gitlab.gnome.org/GNOME/libgsf"
arch="all"
license="LGPL-2.1-only"
depends_dev="bzip2-dev"
makedepends="
	$depends_dev
	glib-dev
	gobject-introspection-dev
	intltool
	libxml2-dev
	python3
	zlib-dev
	"
subpackages="$pkgname-dev $pkgname-doc $pkgname-lang"
source="https://download.gnome.org/sources/libgsf/${pkgver%.*}/libgsf-$pkgver.tar.xz"

# secfixes:
#   1.14.41-r0:
#     - CVE-2016-9888

build() {
	sed -i -e 's/gsf-gnome//' -e 's/thumbnailer//' Makefile.*
	./configure \
		--build=$CBUILD \
		--host=$CHOST \
		--prefix=/usr \
		--sysconfdir=/etc \
		--localstatedir=/var \
		--mandir=/usr/share/man \
		--disable-static \
		--without-gnome-vfs \
		--without-bonobo \
		--enable-introspection
	make
}

check() {
	make check XFAIL_TESTS="test-regress-iconv test-regress-meta"
}

package() {
	make DESTDIR="$pkgdir" install
	rm -f "$pkgdir"/usr/share/man/man1/gsf-office-thumbnailer.1
}

sha512sums="
