From ef9762281dba1b8773da727d943d851334476483 Mon Sep 17 00:00:00 2001
From: grorp <grorp@posteo.de>
Date: Mon, 26 Oct 2026 18:46:40 +0100
Subject: [PATCH 3/3] widget: gtk4: Handle when click gesture is cancelled by
 touch scrolling

When the scroll gesture claims the sequence, our click gesture is
cancelled and we don't receive a release event.

This means VTE thinks the left mouse button is still pressed and
m_will_select_after_threshold remains true.
This can be tested by swipe-scrolling with your finger and moving the
mouse afterwards. Moving the mouse now selects text even though no
mouse button is pressed.

Fix that by handling the cancellation.
---
 src/vte.cc         | 25 +++++++++++++++++++++++--
 src/vteinternal.hh |  3 ++-
 src/widget.cc      | 29 +++++++++++++++++++++++++++++
 src/widget.hh      |  2 ++
 4 files changed, 56 insertions(+), 3 deletions(-)

diff --git a/src/vte.cc b/src/vte.cc
index 5418a65c..7bcec3af 100644
--- a/src/vte.cc
+++ b/src/vte.cc
@@ -7290,7 +7290,7 @@ Terminal::start_selection (vte::view::coords const& pos,
 }
 
 bool
-Terminal::maybe_end_selection()
+Terminal::maybe_end_selection(bool cancelled)
 {
 	if (m_selecting) {
 		/* Copy only if something was selected. */
@@ -7309,7 +7309,7 @@ Terminal::maybe_end_selection()
 		return true;
 	}
 
-        if (m_will_select_after_threshold) {
+        if (m_will_select_after_threshold && !cancelled) {
                 deselect_all();
                 /* This means we handled the press event ourselves, so don't
                 * allow sending the release event to the app either. */
@@ -7722,6 +7722,27 @@ Terminal::widget_mouse_release(vte::platform::MouseEvent const& event)
 	return handled;
 }
 
+void
+Terminal::widget_mouse_cancel()
+{
+        /* This mirrors Terminal::widget_mouse_release but avoids side effects. */
+
+        /* Need to ensure the ringview is updated. */
+        ringview_update();
+
+        stop_autoscroll();
+
+        maybe_end_selection(true);
+        m_mouse_handled_buttons = 0;
+        m_mouse_pressed_buttons = 0;
+
+        m_will_select_after_threshold = false;
+
+        set_pointer_autohidden(false);
+        hyperlink_hilite_update();
+        match_hilite_update();
+}
+
 void
 Terminal::widget_focus_in()
 {
diff --git a/src/vteinternal.hh b/src/vteinternal.hh
index 9f7093a7..cb413e70 100644
--- a/src/vteinternal.hh
+++ b/src/vteinternal.hh
@@ -1126,6 +1126,7 @@ public:
         bool widget_mouse_motion(vte::platform::MouseEvent const& event);
         bool widget_mouse_press(vte::platform::MouseEvent const& event);
         bool widget_mouse_release(vte::platform::MouseEvent const& event);
+        void widget_mouse_cancel();
         void widget_mouse_enter(vte::platform::MouseEvent const& event);
         void widget_mouse_leave(vte::platform::MouseEvent const& event);
         bool widget_mouse_scroll(vte::platform::ScrollEvent const& event);
@@ -1324,7 +1325,7 @@ public:
 
         void start_selection(vte::view::coords const& pos,
                              SelectionType type);
-        bool maybe_end_selection();
+        bool maybe_end_selection(bool cancelled = false);
 
         void select_all();
         void deselect_all();
diff --git a/src/widget.cc b/src/widget.cc
index 56f37335..2c555982 100644
--- a/src/widget.cc
+++ b/src/widget.cc
@@ -567,6 +567,19 @@ catch (...)
         vte::log_exception();
 }
 
+static void
+click_end_cb(GtkGestureClick* gesture,
+             GdkEventSequence* sequence,
+             Widget* that) noexcept
+try
+{
+        that->gesture_click_end(gesture, sequence);
+}
+catch (...)
+{
+        vte::log_exception();
+}
+
 static void
 click_unpaired_release_cb(GtkGestureClick* gesture,
                           double x,
@@ -913,6 +926,8 @@ Widget::constructed() noexcept
                          G_CALLBACK(click_released_cb), this);
         g_signal_connect(gesture.get(), "unpaired-release",
                          G_CALLBACK(click_unpaired_release_cb), this);
+        g_signal_connect(gesture.get(), "end",
+                         G_CALLBACK(click_end_cb), this);
         gtk_event_controller_set_name(GTK_EVENT_CONTROLLER(gesture.get()), "vte-click-gesture");
         gtk_widget_add_controller(m_widget, GTK_EVENT_CONTROLLER(gesture.release()));
 
@@ -1410,6 +1425,20 @@ Widget::gesture_click_unpaired_release(GtkGestureClick* gesture,
                 gtk_gesture_set_state(GTK_GESTURE(gesture), GTK_EVENT_SEQUENCE_CLAIMED);
 }
 
+void
+Widget::gesture_click_end(GtkGestureClick* gesture, GdkEventSequence *sequence)
+{
+        auto current = gtk_gesture_single_get_current_sequence(GTK_GESTURE_SINGLE(gesture));
+        if (gtk_gesture_handles_sequence(GTK_GESTURE(gesture), current))
+                return;
+
+        _vte_debug_print(vte::debug::category::EVENTS, "Click gesture cancelled");
+        /* This can happen if the sequence is claimed by touch scrolling.
+         * We don't receive GtkGestureClick::released in that case. */
+
+        terminal()->widget_mouse_cancel();
+}
+
 #endif /* VTE_GTK == 4 */
 
 void
diff --git a/src/widget.hh b/src/widget.hh
index c1807143..8c8b4e2c 100644
--- a/src/widget.hh
+++ b/src/widget.hh
@@ -473,6 +473,8 @@ public:
                                             double y,
                                             unsigned button,
                                             GdkEventSequence* sequence);
+        void gesture_click_end(GtkGestureClick* gesture,
+                               GdkEventSequence* sequence);
         void gesture_long_press_pressed(GtkGestureLongPress* gesture,
                                         double x,
                                         double y);
