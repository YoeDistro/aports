From 2fca47fdedba29ea0ca44e9475ef34ae18ba5fed Mon Sep 17 00:00:00 2001
From: grorp <grorp@posteo.de>
Date: Wed, 28 Oct 2026 16:08:05 +0100
Subject: [PATCH 1/3] widget: Don't claim the event on press when selecting

Currently, any click on the terminal is claimed by the selection code
immediately, as soon as the press event arrives.
This breaks swiping to scroll on touch. It also breaks the long-press
gesture (supposed to bring up the context menu).

The only thing that actually happens on press is "deselect all". We
already only start selecting once a movement threshold is crossed.

This change defers "deselect all" to either selection-start or the
release event. This means we can also delay claiming the event sequence
to that point, which makes touch scrolling work.

When the scroll gesture claims the sequence, our click gesture is
cancelled (we don't receive a release event), so the current selection
is kept when scrolling.

(While touch scrolling did work before, before recent GTK changes, I'm
not sure why as the VTE code doesn't seem to allow that.)
---
 src/vte.cc | 19 ++++++++++++++-----
 1 file changed, 14 insertions(+), 5 deletions(-)

diff --git a/src/vte.cc b/src/vte.cc
index 9586f10d..5418a65c 100644
--- a/src/vte.cc
+++ b/src/vte.cc
@@ -7309,8 +7309,12 @@ Terminal::maybe_end_selection()
 		return true;
 	}
 
-        if (m_will_select_after_threshold)
+        if (m_will_select_after_threshold) {
+                deselect_all();
+                /* This means we handled the press event ourselves, so don't
+                * allow sending the release event to the app either. */
                 return true;
+        }
 
         return false;
 }
@@ -7423,6 +7427,7 @@ Terminal::widget_mouse_motion(vte::platform::MouseEvent const& event)
                                               pos.x, pos.y))
                         return true;
 
+                deselect_all();
                 start_selection(vte::view::coords(m_mouse_last_position.x, m_mouse_last_position.y),
                                 SelectionType::eCHAR);
         }
@@ -7511,10 +7516,14 @@ Terminal::widget_mouse_press(vte::platform::MouseEvent const& event)
 				}
 			}
 			if (start_selecting) {
-				deselect_all();
                                 m_will_select_after_threshold = true;
                                 m_selection_block_mode = !!(m_modifiers & GDK_CONTROL_MASK);
-				handled = true;
+                                /* Do not mark the event as handled for GTK yet,
+                                 * this could still be e.g. the start of a
+                                 * touch scrolling gesture.
+                                 * Don't send it to the app though, we will
+                                 * handle it ourselves once a movement
+                                 * threshold is crossed. */
 			}
 			if (extend_selecting) {
 				/* The whole selection code needs to be
@@ -7560,14 +7569,14 @@ Terminal::widget_mouse_press(vte::platform::MouseEvent const& event)
 			break;
 		}
                 if (event.button_value() >= 1 && event.button_value() <= 15) {
-                        if (handled)
+                        if (handled || start_selecting)
                                 m_mouse_handled_buttons |= (1 << (event.button_value() - 1));
                         else
                                 m_mouse_handled_buttons &= ~(1 << (event.button_value() - 1));
                 }
 		/* If we haven't done anything yet, try sending the mouse
 		 * event to the app. */
-		if (handled == FALSE) {
+		if (handled == FALSE && start_selecting == FALSE) {
                         handled = maybe_send_mouse_button(rowcol, event);
 		}
 		break;
-- 
