From 128dedb3a9467e9cc93c038287ba4ad85cd998b0 Mon Sep 17 00:00:00 2001
From: grorp <grorp@posteo.de>
Date: Mon, 26 Oct 2026 17:29:33 +0100
Subject: [PATCH 2/3] widget: gtk4: Remove no-op GtkGestureClick::stopped
 handler

This tells us that there will be no double or triple-click event coming
during the current click anymore, because distance/time thresholds have
been exceeded.

We don't care about that, the press and release handlers already deal
with the events as they arrive.
---
 src/widget.cc | 23 -----------------------
 src/widget.hh |  1 -
 2 files changed, 24 deletions(-)

diff --git a/src/widget.cc b/src/widget.cc
index 4489a3ac..56f37335 100644
--- a/src/widget.cc
+++ b/src/widget.cc
@@ -567,18 +567,6 @@ catch (...)
         vte::log_exception();
 }
 
-static void
-click_stopped_cb(GtkGestureClick* gesture,
-                 Widget* that) noexcept
-try
-{
-        that->gesture_click_stopped(gesture);
-}
-catch (...)
-{
-        vte::log_exception();
-}
-
 static void
 click_unpaired_release_cb(GtkGestureClick* gesture,
                           double x,
@@ -923,8 +911,6 @@ Widget::constructed() noexcept
                          G_CALLBACK(click_pressed_cb), this);
         g_signal_connect(gesture.get(), "released",
                          G_CALLBACK(click_released_cb), this);
-        g_signal_connect(gesture.get(), "stopped",
-                         G_CALLBACK(click_stopped_cb), this);
         g_signal_connect(gesture.get(), "unpaired-release",
                          G_CALLBACK(click_unpaired_release_cb), this);
         gtk_event_controller_set_name(GTK_EVENT_CONTROLLER(gesture.get()), "vte-click-gesture");
@@ -1398,15 +1384,6 @@ Widget::gesture_click_released(GtkGestureClick* gesture,
                 gtk_gesture_set_state(GTK_GESTURE(gesture), GTK_EVENT_SEQUENCE_CLAIMED);
 }
 
-void
-Widget::gesture_click_stopped(GtkGestureClick* gesture)
-{
-        _vte_debug_print(vte::debug::category::EVENTS, "Click gesture stopped");
-
-        // FIXMEgtk4 what's the right thing to do here???
-        // Should probably stop selection expansion mode, reset stored buttons, ...?
-}
-
 void
 Widget::gesture_click_unpaired_release(GtkGestureClick* gesture,
                                        double x,
diff --git a/src/widget.hh b/src/widget.hh
index 4c978d5d..c1807143 100644
--- a/src/widget.hh
+++ b/src/widget.hh
@@ -468,7 +468,6 @@ public:
                                     int press_count,
                                     double x,
                                     double y);
-        void gesture_click_stopped(GtkGestureClick* gesture);
         void gesture_click_unpaired_release(GtkGestureClick* gesture,
                                             double x,
                                             double y,
